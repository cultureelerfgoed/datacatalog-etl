@prefix dash: <http://datashapes.org/dash#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dsr: <https://linkeddata.cultureelerfgoed.nl/def/datasetregister/> .
@prefix dsrgrp: <https://linkeddata.cultureelerfgoed.nl/def/datasetregister/group/> .
@prefix dsrsh: <https://linkeddata.cultureelerfgoed.nl/def/datasetregister/shape/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix graph: <https://pilot.rce.triply.cc/rce:rce-catalog-ontwikkel/Data-Catalog/graphs/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

graph:data-model {
    eli:LegalResource a rdfs:Class ;
        rdfs:label "Legal resource"@en,
            "Wet of regeling"@nl .

    dct:Frequency a rdfs:Class ;
        rdfs:label "Frequency (EU)"@en,
            "Frequentie (EU)"@nl .

    dct:LicenseDocument a rdfs:Class ;
        rdfs:label "Licence"@en,
            "Licentie"@nl .

    <https://creativecommons.org/publicdomain/zero/1.0/> a dct:LicenseDocument ;
        rdfs:label "CC0 1.0"@en,
            "CC0 1.0"@nl .

    <https://creativecommons.org/licenses/by/4.0/> a dct:LicenseDocument ;
        rdfs:label "CC BY 4.0"@en,
            "CC BY 4.0"@nl .

    <https://creativecommons.org/licenses/by/3.0/> a dct:LicenseDocument ;
        rdfs:label "CC BY 3.0"@en,
            "CC BY 3.0"@nl .

    <https://creativecommons.org/licenses/by-sa/4.0/> a dct:LicenseDocument ;
        rdfs:label "CC BY-SA 4.0"@en,
            "CC BY-SA 4.0"@nl .

    <https://creativecommons.org/publicdomain/mark/1.0/> a dct:LicenseDocument ;
        rdfs:label "Public Domain Mark 1.0"@en,
            "Public Domain Mark 1.0"@nl .

    <http://rightsstatements.org/vocab/UND/1.0/> a dct:LicenseDocument ;
        rdfs:label "Copyright Undetermined (RS)"@en,
            "Copyright Undetermined (RS)"@nl .

    <http://rightsstatements.org/vocab/InC/1.0/> a dct:LicenseDocument ;
        rdfs:label "In Copyright (RS)"@en,
            "In Copyright (RS)"@nl .

    dct:MediaTypeOrExtent a rdfs:Class ;
        rdfs:label "File format"@en,
            "Bestandsformaat"@nl .

    dct:RightsStatement a rdfs:Class ;
        rdfs:label "Access right (EU)"@en,
            "Toegangsrecht (EU)"@nl .

    dct:Standard a rdfs:Class ;
        rdfs:label "Exchange model / standard"@en,
            "Uitwisselmodel / standaard"@nl .

    skos:Concept a rdfs:Class ;
        rdfs:label "Concept"@en,
            "Begrip"@nl .

    skos:ConceptScheme a rdfs:Class ;
        rdfs:label "Concept scheme"@en,
            "Begrippenlijst"@nl .

    vcard:Organization a rdfs:Class ;
        rdfs:label "Contact point"@en,
            "Contactpunt"@nl .

    dcat:Catalog a rdfs:Class ;
        rdfs:label "Catalogue"@en,
            "Catalogus"@nl ;
        rdfs:comment "Dataset register of the RCE."@en,
            "Datasetregister van de RCE."@nl .

    dcat:Dataset a rdfs:Class ;
        rdfs:label "Dataset"@en,
            "Dataset"@nl ;
        rdfs:comment "Coherent set of RCE data forming a database or standing on its own, regardless of format or storage."@en,
            "Samenhangende set gegevens van de RCE die een database vormt of op zichzelf staat, ongeacht vorm of opslag."@nl .

    dcat:Distribution a rdfs:Class ;
        rdfs:label "Distribution"@en,
            "Distributie"@nl ;
        rdfs:comment "Form in which the dataset is available (application, publication, SPARQL endpoint)."@en,
            "Vorm waarin de dataset beschikbaar is (applicatie, publicatie, SPARQL-endpoint)."@nl .

    foaf:Organization a rdfs:Class ;
        rdfs:label "Organisation"@en,
            "Organisatie"@nl .

    dsr:intern a rdf:Property ;
        rdfs:label "Internal"@en,
            "Intern"@nl ;
        rdfs:comment "Annotation on a property shape: true = internal management information that is never published (e.g. in the public catalogue or DCAT-AP-NL export)."@en,
            "Annotatie op een property shape: true = intern beheergegeven dat nooit wordt gepubliceerd (bijv. in de publieke catalogus of de DCAT-AP-NL-export)."@nl ;
        rdfs:domain sh:PropertyShape ;
        rdfs:range xsd:boolean .

    dsr:Beperking a rdfs:Class ;
        rdfs:label "Restriction"@en,
            "Beperking"@nl ;
        rdfs:comment "Restrictions on retrieving the data."@en,
            "Beperkingen bij het ophalen van de data."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:ChoiObject a rdfs:Class ;
        rdfs:label "Architecture object"@en,
            "Architectuurobject"@nl ;
        rdfs:comment "Classification according to the architecture: CHO, KNOWLEDGE, CASE, THESAURUS, bibliographic data, images."@en,
            "Indeling conform architectuur: CHO, KENNIS, ZAAK, THESAURUS, Bibliografische gegevens, Afbeeldingen."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Creatieproces a rdfs:Class ;
        rdfs:label "Creation process"@en,
            "Creatieproces"@nl ;
        rdfs:comment "Business process in which the data is created, changed or managed."@en,
            "Bedrijfsproces waarin de data wordt gecreëerd, gewijzigd of beheerd."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Datasettype a rdfs:Class ;
        rdfs:label "Dataset type"@en,
            "Datasettype"@nl ;
        rdfs:comment "Type of data in the dataset."@en,
            "Type data in de dataset."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Domein a rdfs:Class ;
        rdfs:label "Domain"@en,
            "Domein"@nl ;
        rdfs:comment "Heritage domain of the dataset."@en,
            "Erfgoeddomein van de dataset."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Functie a rdfs:Class ;
        rdfs:label "Function"@en,
            "Functie"@nl ;
        rdfs:comment "Function (role) within the RCE, e.g. Head of Archaeology."@en,
            "Functie (rol) binnen de RCE, bijvoorbeeld Hoofd Archeologie."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Herkomst a rdfs:Class ;
        rdfs:label "Origin"@en,
            "Herkomst"@nl ;
        rdfs:comment "Origin of the data: RCE, third parties, unknown."@en,
            "Herkomst van de data: RCE, derden, onbekend."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Informatiestructuur a rdfs:Class ;
        rdfs:label "Information structure"@en,
            "Informatiestructuur"@nl ;
        rdfs:comment "How the data is structured."@en,
            "Wijze waarop de data gestructureerd is."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:KlasseAvg a rdfs:Class ;
        rdfs:label "GDPR class"@en,
            "Klasse AVG"@nl ;
        rdfs:comment "GDPR classification of personal data (annex 1)."@en,
            "AVG-classificatie van persoonsgegevens (bijlage 1)."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Kwaliteitsscore a rdfs:Class ;
        rdfs:label "Quality score"@en,
            "Kwaliteitsscore"@nl ;
        rdfs:comment "Score per quality dimension (0 = not assessed, 1 = low, 2 = medium, 3 = high)."@en,
            "Score per kwaliteitsdimensie (0 = niet beoordeeld, 1 = laag, 2 = gemiddeld, 3 = hoog)."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Prioriteit a rdfs:Class ;
        rdfs:label "Priority"@en,
            "Prioriteit"@nl ;
        rdfs:comment "Importance of the dataset for the RCE: high, medium, low; * = still to be done (annex 2)."@en,
            "Belang van de dataset voor de RCE: hoog, gemiddeld, laag; * = moet nog (bijlage 2)."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Publicatievorm a rdfs:Class ;
        rdfs:label "Publication form"@en,
            "Publicatievorm"@nl ;
        rdfs:comment "How the data is published on the web (LOD, web service, website)."@en,
            "Wijze waarop de data op het web is gepubliceerd (LOD, webservice, website)."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Rubriek a rdfs:Class ;
        rdfs:label "Category"@en,
            "Rubriek"@nl ;
        rdfs:comment "RCE category (Knowledge base)."@en,
            "RCE-rubriek (Kennisbank)."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:SoortGeometrie a rdfs:Class ;
        rdfs:label "Geometry type"@en,
            "Soort geometrie"@nl ;
        rdfs:comment "None, line, point, polygon, indirect geometry."@en,
            "Geen, lijn, punt, vlak, indirecte geometrie."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Systeem a rdfs:Class ;
        rdfs:label "System"@en,
            "Systeem"@nl ;
        rdfs:comment "Application or technical environment in which data is managed or occurs."@en,
            "Applicatie of technische omgeving waarin data wordt beheerd of voorkomt."@nl ;
        rdfs:subClassOf skos:Concept .

    dsr:Systeemsoort a rdfs:Class ;
        rdfs:label "Word or data system"@en,
            "Woord- of datasysteem"@nl ;
        rdfs:comment "Master table as word system or data system."@en,
            "Stamtabel als woordsysteem of datasysteem."@nl ;
        rdfs:subClassOf skos:Concept .

    dsrsh:begrip a sh:NodeShape ;
        rdfs:label "Concept"@en,
            "Begrip"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-in-scheme,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label ;
        sh:targetClass skos:Concept .

    dsrsh:begrippenlijst a sh:NodeShape ;
        rdfs:label "Concept scheme"@en,
            "Begrippenlijst"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrippenlijst/" ;
        sh:property dsrsh:begrippenlijst-definition,
            dsrsh:begrippenlijst-pref-label ;
        sh:targetClass skos:ConceptScheme .

    dsrsh:beperking a sh:NodeShape ;
        rdfs:label "Restriction"@en,
            "Beperking"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:beperking-in-scheme ;
        sh:targetClass dsr:Beperking .

    dsrsh:bestandsformaat a sh:NodeShape ;
        rdfs:label "File format"@en,
            "Bestandsformaat"@nl ;
        sh:property dsrsh:bestandsformaat-label ;
        sh:targetClass dct:MediaTypeOrExtent .

    dsrsh:catalogus a sh:NodeShape ;
        rdfs:label "Catalogue"@en,
            "Catalogus"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/catalogus/" ;
        sh:property dsrsh:catalog-contact-point,
            dsrsh:catalog-dataset,
            dsrsh:catalog-description,
            dsrsh:catalog-publisher,
            dsrsh:catalog-title ;
        sh:targetClass dcat:Catalog .

    dsrsh:choi-object a sh:NodeShape ;
        rdfs:label "Architecture object"@en,
            "Architectuurobject"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:choi-object-in-scheme ;
        sh:targetClass dsr:ChoiObject .

    dsrsh:contactpunt a sh:NodeShape ;
        rdfs:label "Contact point"@en,
            "Contactpunt"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/contactpunt/" ;
        sh:property dsrsh:contactpunt-fn,
            dsrsh:contactpunt-has-email,
            dsrsh:contactpunt-has-url ;
        sh:targetClass vcard:Organization .

    dsrsh:creatieproces a sh:NodeShape ;
        rdfs:label "Creation process"@en,
            "Creatieproces"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:creatieproces-in-scheme ;
        sh:targetClass dsr:Creatieproces .

    dsrsh:dataset a sh:NodeShape ;
        rdfs:label "Dataset"@en,
            "Dataset"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/" ;
        sh:property dsrsh:dataset-access-rights,
            dsrsh:dataset-accrual-periodicity,
            dsrsh:dataset-actualiteit,
            dsrsh:dataset-apm-code,
            dsrsh:dataset-applicable-legislation,
            dsrsh:dataset-avg-klasse,
            dsrsh:dataset-batch,
            dsrsh:dataset-beheeromgeving,
            dsrsh:dataset-beperking,
            dsrsh:dataset-beschikbaar-in,
            dsrsh:dataset-bronsysteem,
            dsrsh:dataset-choi-object,
            dsrsh:dataset-compleetheid,
            dsrsh:dataset-conforms-to,
            dsrsh:dataset-consistentie,
            dsrsh:dataset-contact-point,
            dsrsh:dataset-creatieproces,
            dsrsh:dataset-creator,
            dsrsh:dataset-dataeigenaar,
            dsrsh:dataset-datasettype,
            dsrsh:dataset-datasteward,
            dsrsh:dataset-datum-opname-in-register,
            dsrsh:dataset-description,
            dsrsh:dataset-distribution,
            dsrsh:dataset-domein,
            dsrsh:dataset-duplicaat-in,
            dsrsh:dataset-editorial-note,
            dsrsh:dataset-elementtype,
            dsrsh:dataset-functioneel-beheerder,
            dsrsh:dataset-gepubliceerd-op-het-web,
            dsrsh:dataset-herkomst,
            dsrsh:dataset-identifier,
            dsrsh:dataset-in-archief,
            dsrsh:dataset-in-erfgoedatlas,
            dsrsh:dataset-in-nde-datasetregister,
            dsrsh:dataset-informatiestructuur,
            dsrsh:dataset-is-linked-open-data,
            dsrsh:dataset-master-of-referencedata,
            dsrsh:dataset-is-open-data,
            dsrsh:dataset-is-origineel,
            dsrsh:dataset-landing-page,
            dsrsh:dataset-license,
            dsrsh:dataset-nauwkeurigheid,
            dsrsh:dataset-ondersteunt-iiif,
            dsrsh:dataset-oorspronkelijke-bron,
            dsrsh:dataset-origineel-in,
            dsrsh:dataset-paginanaam,
            dsrsh:dataset-pid-gebruik,
            dsrsh:dataset-precisie,
            dsrsh:dataset-prioriteit,
            dsrsh:dataset-publicatievorm,
            dsrsh:dataset-publisher,
            dsrsh:dataset-rubriek,
            dsrsh:dataset-soort-geometrie,
            dsrsh:dataset-status,
            dsrsh:dataset-systeemsoort,
            dsrsh:dataset-termen-gebruik,
            dsrsh:dataset-theme,
            dsrsh:dataset-title,
            dsrsh:dataset-volgt-generiek-lod-model,
            dsrsh:dataset-waar-te-vinden,
            dsrsh:dataset-wettelijke-grondslag,
            dsrsh:dataset-woordsysteem,
            dsrsh:dataset-woordsysteem-toelichting ;
        sh:targetClass dcat:Dataset .

    dsrsh:datasettype a sh:NodeShape ;
        rdfs:label "Dataset type"@en,
            "Datasettype"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:datasettype-in-scheme ;
        sh:targetClass dsr:Datasettype .

    dsrsh:distributie a sh:NodeShape ;
        rdfs:label "Distribution"@en,
            "Distributie"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/distributie/" ;
        sh:property dsrsh:distribution-access-url,
            dsrsh:distribution-description,
            dsrsh:distribution-format,
            dsrsh:distribution-license,
            dsrsh:distribution-media-type,
            dsrsh:distribution-title ;
        sh:targetClass dcat:Distribution .

    dsrsh:domein a sh:NodeShape ;
        rdfs:label "Domain"@en,
            "Domein"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:domein-in-scheme ;
        sh:targetClass dsr:Domein .

    dsrsh:functie a sh:NodeShape ;
        rdfs:label "Function"@en,
            "Functie"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:functie-in-scheme ;
        sh:targetClass dsr:Functie .

    dsrsh:herkomst a sh:NodeShape ;
        rdfs:label "Origin"@en,
            "Herkomst"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:herkomst-in-scheme ;
        sh:targetClass dsr:Herkomst .

    dsrsh:informatiestructuur a sh:NodeShape ;
        rdfs:label "Information structure"@en,
            "Informatiestructuur"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:informatiestructuur-in-scheme ;
        sh:targetClass dsr:Informatiestructuur .

    dsrsh:klasse-avg a sh:NodeShape ;
        rdfs:label "GDPR class"@en,
            "Klasse AVG"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:klasse-avg-in-scheme ;
        sh:targetClass dsr:KlasseAvg .

    dsrsh:kwaliteitsscore a sh:NodeShape ;
        rdfs:label "Quality score"@en,
            "Kwaliteitsscore"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:kwaliteitsscore-in-scheme ;
        sh:targetClass dsr:Kwaliteitsscore .

    dsrsh:organisatie a sh:NodeShape ;
        rdfs:label "Organisation"@en,
            "Organisatie"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/" ;
        sh:property dsrsh:organisatie-name ;
        sh:targetClass foaf:Organization .

    dsrsh:prioriteit a sh:NodeShape ;
        rdfs:label "Priority"@en,
            "Prioriteit"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:prioriteit-in-scheme ;
        sh:targetClass dsr:Prioriteit .

    dsrsh:publicatievorm a sh:NodeShape ;
        rdfs:label "Publication form"@en,
            "Publicatievorm"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:publicatievorm-in-scheme ;
        sh:targetClass dsr:Publicatievorm .

    dsrsh:rubriek a sh:NodeShape ;
        rdfs:label "Category"@en,
            "Rubriek"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:rubriek-in-scheme ;
        sh:targetClass dsr:Rubriek .

    dsrsh:soort-geometrie a sh:NodeShape ;
        rdfs:label "Geometry type"@en,
            "Soort geometrie"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:soort-geometrie-in-scheme ;
        sh:targetClass dsr:SoortGeometrie .

    dsrsh:standaard a sh:NodeShape ;
        rdfs:label "Exchange model / standard"@en,
            "Uitwisselmodel / standaard"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/standaard/" ;
        sh:property dsrsh:standaard-label ;
        sh:targetClass dct:Standard .

    dsrsh:systeem a sh:NodeShape ;
        rdfs:label "System"@en,
            "Systeem"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:systeem-in-scheme ;
        sh:targetClass dsr:Systeem .

    dsrsh:systeemsoort a sh:NodeShape ;
        rdfs:label "Word or data system"@en,
            "Woord- of datasysteem"@nl ;
        dash:stem "https://linkeddata.cultureelerfgoed.nl/datacatalog/id/begrip/" ;
        sh:property dsrsh:begrip-definition,
            dsrsh:begrip-notation,
            dsrsh:begrip-pref-label,
            dsrsh:systeemsoort-in-scheme ;
        sh:targetClass dsr:Systeemsoort .

    dsrsh:wet a sh:NodeShape ;
        rdfs:label "Legal resource"@en,
            "Wet of regeling"@nl ;
        sh:property dsrsh:wet-label ;
        sh:targetClass eli:LegalResource .

    dsrsh:begrip-in-scheme a sh:PropertyShape ;
        sh:class skos:ConceptScheme ;
        sh:description "Concept scheme the concept belongs to."@en,
            "Begrippenlijst waartoe het begrip behoort."@nl ;
        sh:group dsrgrp:algemeen ;
        sh:minCount 1 ;
        sh:name "In concept scheme"@en,
            "In begrippenlijst"@nl ;
        sh:nodeKind sh:IRI ;
        sh:order 4 ;
        sh:path skos:inScheme .

    dsrsh:begrippenlijst-definition a sh:PropertyShape ;
        sh:datatype rdf:langString ;
        sh:description "Description of the concept scheme."@en,
            "Omschrijving van de begrippenlijst."@nl ;
        sh:group dsrgrp:algemeen ;
        sh:name "Definition"@en,
            "Definitie"@nl ;
        sh:nodeKind sh:Literal ;
        sh:order 2 ;
