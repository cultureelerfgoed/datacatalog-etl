    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/8adabe29-b123-5a2f-9250-bbf3b7733976> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description """Deze dataset genereert een kaartbeeld van Tiendwegen in Nederland. In de dataset zijn de Tiendwegen opgenomen op basis van de gegevens van Paul Minkjan. Tiendwegen zijn polderwegen als verbinding tussen bouw- en weilanden en de boerderijen. Tiendwegen zijn ontstaan als karrenpaden en lopen veelal evenwijdig aan de ontginningsbasis van een polder. Ze staan haaks op de langgerekte kavels.

De gegevens zijn bijgewerkt in 2023"""@nl ;
        dct:identifier "128" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
