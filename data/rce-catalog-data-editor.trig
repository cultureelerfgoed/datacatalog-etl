    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/6bf7dfb1-df74-5572-9c2c-6577ea065444> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description """Aan de hand van deze dataset wordt de kaartlaag rijksbeschermde groenaanleggen gegenereerd die parken, tuinen, erven en begraafplaatsen laat zien die beschermd zijn als rijksmonument. Een groenaanleg is een aanleg van onder meer paden, waterpartijen en beplantingen. Verdedigingswerken zijn niet opgenomen op deze kaartlaag (tenzij omgevormd tot stadspark).

De aanleg kan een zelfstandige eenheid zijn óf deel uitmaken van een ensemble, zoals een villa met tuin of een klooster met kloostertuin. De laatste wijzigingen dateren van 2023."""@nl ;
        dct:identifier "102" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
