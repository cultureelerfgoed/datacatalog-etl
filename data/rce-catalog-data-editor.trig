    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/171392ad-5687-5b54-a802-894833472452> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description "Overzicht van geïnventariseerde monumenten uit de periode 1850-1940. Deze database is samengesteld in de jaren negentig voor het Monumenten Inventarisatie Project. Dit project beoogde een landelijke inventarisatie van monumenten uit de periode 1850-1940 en werd provinciaal aangepakt. Onderdeel van het project waren onder andere gemeentebeschrijvingen en een generieke database. Behalve de provincie Groningen zijn alle monumenten opgevoerd, samen zo'n 150.000 records. Deze records bevatten soms een enkel pand maar vaak ook hele blokken waardoor de reikwijdte van de database mogelijk enkele honderdduizenden gebouwen betreft. Ook beschikbaar via https://data.overheid.nl/dataset/10651-monumenten-inventarisatie-project--mip--objecten."@nl ;
        dct:identifier "83" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
