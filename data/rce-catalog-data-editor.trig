    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/ed7fa885-a964-5e9e-831d-52d5a89a60f7> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description "Met behulp van deze dataset wordt een beeld geschetst van het Nederlandse landschap sinds het einde van de laatste ijstijd, 11.700 geleden tot heden. De paleogeografische kaarten maken inzichtelijk hoe het Nederlandse landschap er gedurende deze duizenden jaren heeft uitgezien. Deze set kaarten zijn bedoeld voor gebruik op landelijk niveau. Bij inzoomen op regionaal of lokaal niveau dient de gebruiker zich bewust te zijn van schijnnauwkeurigheid. De kaarten zijn ook gepubliceerd in de Atlas van het Holoceen in 2011 en in 2020 bijgewerkt met de laatste gegevens."@nl ;
        dct:identifier "96" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
