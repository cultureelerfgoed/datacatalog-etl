    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/4306ac9d-5d7f-57e5-902b-e80b812c4487> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description """Beschrijvingen van historische boerderijen, gemaakt door de Stichting Historisch Boerderij Onderzoek (SHBO). De stichting bestond tussen 1960 en 2007. In een database, Farmbase genaamd, hadden de medewerkers iets meer dan 50% van alle (historische) boerderijen in Nederland vastgelegd. Deze database wordt sinds 2008 beheerd door de RCE, maar niet meer aangevuld. In de database zijn onder meer de functies van de boerderijen
vastgelegd, met verwijzingen naar foto’s van de boerderijen en verder de gegevens van eigenaren. Er is ook een dataset met van rijkswege beschermde boerderijen, maar tussen beide is geen relatie."""@nl ;
        dct:identifier "51" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
        dct:publisher <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:title "Farmbase"@nl ;
