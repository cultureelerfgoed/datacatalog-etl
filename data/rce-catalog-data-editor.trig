    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/08bedf16-a28f-5bbd-94fb-de88bd5ea98e> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description "Een droogmakerij is een drooggemalen voormalige plas of meer. De polders in de droogmakerijen hebben veelal een rechtlijnige verkaveling en liggen meestal enkele meters lager dan het omringende gebied. De dataset 'Droogmakerijen' bevat een landelijke kartering van droogmakerijen zoals die als type zijn gedefinieerd in de NAi (Nederlands Architectuur Instituut) Polderatlas. Deze droogmakerijen zijn verdeeld naar ontstaansperiode en kennen datavelden voor huidig polderpeil en jaar van droogmaking. Bij deze dataset horen de datasets Molens en Gemalen, die de bij de betreffende droogmakerij de maalinrichting(en) voor de droogmaking tonen."@nl ;
        dct:identifier "49" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
        dct:publisher <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:title "Droogmakerijen"@nl ;
        skos:editorialNote "Extern ontsloten als webservice via Geovoorziening"@nl ;
