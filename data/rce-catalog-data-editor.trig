    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/3c79311e-5450-5996-9bae-a5aaabe9516a> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description """Overzicht op gemeentelijke niveau (stand begin jaren negentig) van de MIP Gemeentebeschrijvingen (Monumenten Inventarisatie Project). Deze kunnen als pdf (portable document format) worden opgevraagd door de kaartlaag aan te zetten. De gemeentebeschrijvingen variëren sterk in grootte en kwaliteit, maar zijn door de jaren belangrijke uitgangsdocumenten geweest voor gebiedsbeschrijvingen en het aanwijzen van beschermde objecten in zo'n gebied.

Het overzicht dateert uit de jaren tachtig / negentig van de vorige eeuw en is inmiddels vooral geschiedkundig van groot belang."""@nl ;
        dct:identifier "85" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
