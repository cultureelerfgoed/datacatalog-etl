    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/6f6789a5-d45d-561e-a14c-317d2fabb180> a dcat:Dataset ;
        dcatap:applicableLegislation <https://wetten.overheid.nl/BWBR0037521> ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/UNKNOWN> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description "Dataset met metadata van de herkomstgeschiedenis van objecten uit museumcollecties waarvan het vermoeden bestaat dat ze tussen 1933 tot 1945 geroofd, geconfisqueerd of gedwongen verkocht zijn. De Museumvereniging coördineerde het project, de commissie 'Museale Verwervingen vanaf 1933' hield inhoudelijk toezicht en het ministerie van Onderwijs, Cultuur en Wetenschap (OCW) bood financiële ondersteuning. Eind 2018 kwam het onderzoeksproject formeel tot een einde. Het beeldmateriaal dat getoond mag worden is zichtbaar op Cultuurgoederen Tweede Wereldoorlog."@nl ;
        dct:identifier "174" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
