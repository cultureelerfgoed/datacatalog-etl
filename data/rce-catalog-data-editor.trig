    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/c347cf13-81f7-5ad5-93eb-168c12630278> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description """Dataset met lijst van architecten en ambachtslieden ten behoeve van de geïnventariseerde objecten uit de periode 1940-1965, de zogenaamde Wederopbouw. De Rijksdienst voor het Cultureel Erfgoed deed deze inventarisatie aan het begin van de 21ste eeuw en sloeg de gegevens op in de Wederopbouwdatabank. Deze databank heeft jarenlang online gestaan en via een reactieformulier kon iedereen een gebouw toe laten voegen.

Met behulp van de Wederopbouwdatabank zijn enkele tientallen gebouwen aangewezen als rijksmonument."""@nl ;
        dct:identifier "138" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
