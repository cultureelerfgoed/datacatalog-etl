    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/93b2bf5c-3b23-5b71-b7db-91789444f304> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description """Deze dataset bevat de landsdekkende kartering van gemalen volgens de gegevens van de Nederlandse Gemalenstichting (NGS). Zowel de bestaande gemalen (al of niet werkend) als de locaties van verdwenen gemalen zijn opgenomen.

Elk gemaal is middels het gemaalnummer volgens de NGS voorzien van een link naar de betreffende informatiepagina van de [https://www.gemalen.nl/ website van de NGS].

De basis voor deze dataset is een export van het databestand van de NGS op 06 mei 2019. De Rijksdienst voor het Cultureel Erfgoed heeft daar een aantal attributen aan toegevoegd: url's naar fotomateriaal en een url naar de informatiepagina op www.gemalen.nl. Sinds de eerste versie van de dataset is de gegevensset met behulp van fotografen en informatie-inwinning via onder andere www.topotijdreis.nl uitgebreid tot bijna 2.500 gemalen, met een groeiend aantal foto's."""@nl ;
        dct:identifier "55" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
        dct:publisher <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:title "Gemalen"@nl ;
        skos:editorialNote "Extern ontsloten als webservice via Geovoorziening"@nl ;
        dcat:contactPoint <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/contactpunt/f7707d6c-00b4-5d45-9017-f1746dd103ff> ;
        dcat:distribution <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/distributie/34efa40f-6f6c-5b99-95c3-a8ca4c752ab5>,
            <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/distributie/fccd8fcd-ac2d-5d00-9b9d-6ebe3a8d1f5b> ;
