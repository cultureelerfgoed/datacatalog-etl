    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/ea6b4187-047f-5b96-8de7-ebd5ca0c7e1d> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
