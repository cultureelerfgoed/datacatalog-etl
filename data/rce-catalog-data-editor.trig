    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/3faed5b2-edd1-57cd-948f-a7fe0636081b> a dcat:Dataset ;
        dcatap:applicableLegislation <https://wetten.overheid.nl/BWBR0037521> ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/DAILY> ;
        dct:conformsTo <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/standaard/19706944-33d6-5642-80c0-13192c34d1dd> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description "Deze dataset bevat de primaire brondata van cultuurhistorische objecten (CHO’s) zoals beheerd door de Rijksdienst voor het Cultureel Erfgoed (RCE). De dataset vormt de actuele, gezaghebbende registratie en wordt gebruikt als basis voor analyse, publicatie en afgeleide datasets. De dataset beschrijft onder meer: rijksmonumenten, werelderfgoed, beschermde stads- of dorpsgezichten, archeologische terreinen, archeologische vondsten en complexen en archeologische onderzoeken. De gegevens zijn in de loop van de tijd opgebouwd via verschillende registratiesystemen en werkprocessen van de RCE en haar voorgangers. De dataset weerspiegelt steeds de meest recente stand van zaken en bevat geen historische momentopnames."@nl ;
        dct:identifier "176" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
        dct:publisher <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:title "Cultuurhistorische Objecten"@nl ;
        skos:editorialNote "Deze dataset vormt het semantische en conceptuele kader voor betekenis en structuur binnen het datadomein van de RCE."@nl ;
