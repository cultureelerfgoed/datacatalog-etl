    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/ef0b8321-c7a4-55f3-9864-5a27d2f19bd5> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
