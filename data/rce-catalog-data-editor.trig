    <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/dataset/a65f6fab-94c0-5ad5-abc0-75a02c1fe385> a dcat:Dataset ;
        dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
        dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/DAILY> ;
        dct:creator <https://linkeddata.cultureelerfgoed.nl/datacatalog/id/organisatie/f2627b9b-48a4-5005-a80f-cb21045f471e> ;
        dct:description """Deze dataset is een onderdeel van BoneInfo, een database met informatie over dierlijke en menselijke resten uit archeologische vindplaatsen in Nederland, inclusief verwijzingen naar de overwegend grijze literatuur, zoals rapporten en scripties, waarin die gegevens voorkomen. 

Deze dataset bevat een lijst van manieren waarop het archeologische materiaal/de archeologische gegevens verkregen kunnen worden (gebaseerd op een oude lijst van verwervingswijze uit het Archeologisch Basis Register)."""@nl ;
        dct:identifier "123" ;
        dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
